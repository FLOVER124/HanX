#!/bin/sh
# The package owns its embedded CLI. Existing commands from another channel
# remain owned by that channel. Installer passes the target volume as $3.
set -eu
hw_volume=${3:-/}
hw_payload=/Applications/HanX.app/Contents/Resources/CLI/hanx
hw_embedded="${hw_volume%/}$hw_payload"
[ -f "$hw_embedded" ] || { printf '%s\n' 'HanX embedded CLI is missing.' >&2; exit 1; }
hw_bin="${hw_volume%/}/usr/local/bin"
mkdir -p "$hw_bin"
# Retire only the exact command links installed by the former pkg.
for hw_legacy in hanword hanword-cli; do
  hw_old="$hw_bin/$hw_legacy"
  if [ -L "$hw_old" ] && [ "$(readlink "$hw_old")" = "/Applications/HanWord.app/Contents/Resources/CLI/hanword" ]; then
    rm "$hw_old"
  fi
done
for hw_name in hanx hanx-cli; do
  hw_command="$hw_bin/$hw_name"
  if [ -L "$hw_command" ] && [ "$(readlink "$hw_command")" = "$hw_payload" ]; then
    continue
  fi
  if [ -e "$hw_command" ] || [ -L "$hw_command" ]; then
    printf '%s\n' "Keeping existing command: $hw_command" >&2
    continue
  fi
  ln -s "$hw_payload" "$hw_command"
done
# Local single-build cleanup is enabled only by this Mac's owner configuration.
if [ "$hw_volume" = / ]; then
  hw_user=$(/usr/bin/stat -f '%Su' /dev/console)
  if [ "$hw_user" != root ] && [ "$hw_user" != loginwindow ]; then
    hw_home=$(/usr/bin/dscl . -read "/Users/$hw_user" NFSHomeDirectory | /usr/bin/cut -d ' ' -f 2-)
    hw_cleanup="$hw_home/.config/hanx/local-build-cleanup.json"
    hw_helper=/Applications/HanX.app/Contents/Resources/Maintenance/clean-previous-builds.py
    if [ -f "$hw_cleanup" ] && [ -f "$hw_helper" ]; then
      /usr/bin/sudo -H -u "$hw_user" /usr/bin/env PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" /usr/bin/python3 "$hw_helper" || {
        printf '%s\n' 'HanX installed. Previous-build cleanup needs attention.' >&2
        exit 1
      }
    fi
  fi
fi
exit 0
