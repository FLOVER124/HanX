{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanx-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // hanx.io must be a zone on the same Cloudflare account. Remove this block to use only *.workers.dev.
  "routes": [{ "pattern": "mcp.hanx.io", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "FILE_TTL_HOURS": "24",
    "MAX_FILE_MB": "20",
    "ENGINE_INSTANCES": "3"
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "hanx-mcp-files" }],
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "4801", "simple": { "limit": 30, "period": 60 } }],
  "containers": [
    {
      "class_name": "HanxEngine",
      "image": "../engine/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": { "bindings": [{ "name": "ENGINE", "class_name": "HanxEngine" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HanxEngine"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "env": {
    // Local development: `npm run dev` with the engine running at ENGINE_URL (see README).
    "local": {
      "workers_dev": true,
      "routes": [],
      "vars": {
        "FILE_TTL_HOURS": "24",
        "MAX_FILE_MB": "20",
        "ENGINE_URL": "http://127.0.0.1:8080"
      },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "hanx-mcp-files-local" }],
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "4802", "simple": { "limit": 30, "period": 60 } }]
    }
  }
}
